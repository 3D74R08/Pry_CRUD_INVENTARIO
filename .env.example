# ============================================================
# Variables de Entorno - Plataforma de Gestión de Activos TI
# ============================================================

NODE_ENV=production

# Base de Datos PostgreSQL
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=inventario_db
DB_USER=inventario_user
DB_PASSWORD=cambiar_por_password_segura_de_tu_empresa

# Backend API Core
PORT=5000
# Generar una clave secreta segura con: openssl rand -hex 32
JWT_SECRET=tu_clave_secreta_jwt_criptografica_de_alta_entropia_aqui
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# Worker Config
WORKER_POLL_INTERVAL_MS=5000
UPLOAD_DIR=/app/uploads

# Frontend
VITE_API_URL=/api
