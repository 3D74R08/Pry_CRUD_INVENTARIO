# ============================================================
# Variables de Entorno - Plataforma de Gestión de Activos TI
# (Copia este archivo como .env en tu servidor Proxmox o entorno local)
# ============================================================

NODE_ENV=production

# Base de Datos PostgreSQL (Valores listos para Docker)
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=inventario_db
DB_USER=inventario_user
DB_PASSWORD=inventario_secret_pass_2026

# Backend API Core
PORT=5000
# Clave criptográfica para firmas JWT (Puedes cambiarla o usar esta de 256 bits)
JWT_SECRET=c8f94a2b918374d9e0f12a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d
JWT_EXPIRES_IN=8h

# Worker Config
WORKER_POLL_INTERVAL_MS=5000
UPLOAD_DIR=/app/uploads

# Frontend
VITE_API_URL=/api
